{
	"schema_version": 1,
	"quilt_loader": {
		"group": "org.quiltmc",
		"id": "quilt_example_plugin",
		"version": "${version}",
		"metadata": {
			"name": "Quilt Example Plugin",
			"description": "A small example mod which uses quilt-loaders plugins.",
			"contributors": {
				"Your name here": "Owner"
			},
			"contact": {
				"homepage": "https://example.com/",
				"issues": "https://github.com/QuiltMC/quilt-template-mod/issues",
				"sources": "https://github.com/QuiltMC/quilt-template-mod"
			},
			"icon": "assets/quilt_example_plugin/icon.png"
		},
		"intermediate_mappings": "net.fabricmc:intermediary",
		"entrypoints": {
			"init": "com.example.example_mod.ExampleMod"
		},
		"depends": [
			{
				"id": "quilt_loader",
				"versions": ">=0.30.1-beta.4"
			}
		]
	},
    "experimental_quilt_loader_plugin": {
        "class": "org.quiltmc.example.loader.plugin.ExampleLoaderPlugin",
        "packages": [ "org.quiltmc.example.loader.plugin" ]
    }
}
